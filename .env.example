# 复制为 .env 后填写。.env 不提交。
DATABASE_URL=postgresql+psycopg://matrix:matrix@db:5432/matrix
REDIS_URL=redis://redis:6379/0

# 随机长字符串
JWT_SECRET=
# Fernet key，生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEY=

# 微信开放平台 → 第三方平台 → 开发资料
WECHAT_COMPONENT_APPID=
WECHAT_COMPONENT_APPSECRET=
WECHAT_COMPONENT_TOKEN=
WECHAT_COMPONENT_AES_KEY=

PUBLIC_BASE_URL=http://127.0.0.1:5173

# 本地模拟开放平台（只用于开发，生产必须为 false）。开启后上面四项 WECHAT_COMPONENT_* 随便填（AES_KEY 需 43 位），
# 下面填一个已认证测试公众号的 AppID/AppSecret（公众号后台 IP 白名单要包含出口 IP）
WECHAT_MP_MOCK=false
WECHAT_MP_MOCK_APPID=
WECHAT_MP_MOCK_APPSECRET=
WECHAT_MP_MOCK_NAME=
