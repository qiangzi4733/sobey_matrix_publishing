# 浏览器自动化 worker（抖音、视频号）。
# 视频号上传依赖 Google Chrome 的 H.264 解码，Chromium 不行；Chrome 只有 linux/amd64 版本，
# 所以这个镜像固定构建为 amd64（Apple Silicon 开发机上走仿真运行）。
ARG PYTHON_IMAGE=python:3.12-slim
FROM --platform=linux/amd64 ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 中文字体只用于失败截图可读，选体积小的文泉驿
RUN sed -i 's|http://deb.debian.org|https://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update \
    && apt-get install -y --no-install-recommends fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-browser.txt ./
RUN pip install -r requirements.txt -r requirements-browser.txt \
    && patchright install --with-deps chrome \
    && rm -rf /var/lib/apt/lists/*

COPY app ./app

CMD ["celery", "-A", "app.worker.celery_app", "worker", "-Q", "browser", "-c", "2", "-l", "info"]
